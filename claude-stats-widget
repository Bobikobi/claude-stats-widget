        # --------------------------------------------------------- data
        def watch(self):
            """Cheap tick: notice live sessions, fresh data and new code."""
            newest = newest_transcript_mtime()
            was_active = self.session_active
            self.session_active = (time.time() - newest) < ACTIVE_WINDOW
            # a live session changes the numbers fast — refresh right away
            if self.session_active and newest > self.last_seen_mtime:
                self.last_seen_mtime = newest
                self.refresh()
            elif was_active and not self.session_active:
                self.refresh()
            # the script rewrote itself (an upgrade) — restart into it
            mtime = script_mtime()
            if mtime and self.script_mtime and mtime != self.script_mtime:
                self.restart()
            return True

        def restart(self):
            # Never exec into a half-written or broken file: a mid-edit save
            # once killed the widget outright. Compile first, and if it does
            # not parse, keep running the code already in memory.
            try:
                compile(SCRIPT_PATH.read_text(encoding="utf-8"),
                        str(SCRIPT_PATH), "exec")
            except (SyntaxError, OSError, ValueError):
                return
            # nothing to persist here: every setting is written when it changes
            os.execv(sys.executable, [sys.executable, str(SCRIPT_PATH)])

        def refresh(self):
            try:
                self.stats = collect_stats()
            except Exception as exc:  # keep the widget alive on parse errors
                self.footer.set_text(TR[self.lang]["err"].format(e=exc))
                return True
            s = self.stats
            self.tiles["sessions"].set_text(str(s["sessions"]))
            self.tiles["messages"].set_text(str(s["messages"]))
            self.tiles["total_tokens"].set_text(fmt_num(s["total_tokens"]))
            self.tiles["active_days"].set_text(str(s["active_days"]))
            self.tiles["current_streak"].set_text(f'{s["current_streak"]}d')
            self.tiles["longest_streak"].set_text(f'{s["longest_streak"]}d')
            self.tiles["peak_hour"].set_text(fmt_hour(s["peak_hour"]))
            self.tiles["favorite_model"].set_text(s["favorite_model"])
            self.footer.set_text(hp_line(s["total_tokens"], self.lang))
            self.tick_countdown()
            self.check_alerts(s)
            self.update_heatmap()
            return True  # keep the GLib timer running

        def spawn_usage_poll(self):
            """Refresh the real quota off-thread so the UI never stalls."""
            if self.polling:
                return True
            self.polling = True

            def work():
                report = poll_usage()
                def done():
                    self.polling = False
                    if report:
                        self.refresh()
                    return False
                GLib.idle_add(done)

            threading.Thread(target=work, daemon=True).start()
            return True

        def tick_countdown(self):
            """Second-by-second countdown to each window's reset."""
            if not self.stats:
                return True
            t = TR[self.lang]
            now = time.time()
            for key, win_key in (("hour5", "window_5h"), ("week", "window_7d")):
                win = self.stats.get(win_key) or {}
                resets = win.get("resets_at")
                span = win.get("window_seconds") or 1
                if resets:
                    left = max(0, int(resets - now))
                    elapsed = 100.0 * (1 - left / span)
                    countdown = fmt_countdown(left, self.lang)
                else:
                    # no open window: the session is over, quota is fresh
                    left, elapsed, countdown = 0, 100.0, t["fresh"]

                quota = win.get("quota_pct")
                real_quota = quota is not None
                if real_quota:
                    # the honest meter: how much of the quota is gone,
                    # straight from the server's own answer to /usage
                    elapsed = float(quota)
                    text = f"{quota:.0f}%"
                    tip = t["tip_quota"].format(age=win.get("quota_age_min") or 0,
                                                reset=win.get("quota_reset") or "?")
                elif key == "hour5":
                    text = f"{elapsed:.0f}%"
                    tip = t["tip_session"].format(left=countdown)
                else:
                    text = countdown
                    tip = t["tip_countdown"]
                for meters in (self.full_meters, self.mini_meters):
                    if key not in meters:
                        continue
                    lab, val, bar = meters[key]
                    lab.set_text(t[f"{key}_short" if meters is self.mini_meters
                                   else (f"{key}_quota" if real_quota
                                         else f"{key}_reset")])
                    val.set_text(text)
                    bar.set_value(max(0.0, min(100.0, elapsed)))
                    ctx = bar.get_style_context()
                    # real quota gets the warning colours; time progress stays
                    # neutral, because a session ending is not a danger
                    (ctx.remove_class if real_quota else ctx.add_class)("recordbar")
                    bar.set_tooltip_text(tip)
            return True

        def meter_tooltip(self, key, s):
            """Say plainly what this bar's 100% actually means."""
            t = TR[self.lang]
            return t["tip_countdown"]

        def check_alerts(self, s):
            """Warn before the window runs out, not after."""
            t = TR[self.lang]
            for key, pct_key, win_key in (
                    ("hour5", "session_quota_pct", "window_5h"),
                    ("week", "week_quota_pct", "window_7d")):
                pct = s.get(pct_key)
                if pct is None:
                    continue    # no real number yet, nothing worth warning about
                level = 100 if pct >= 100 else 95 if pct >= 95 else 80 if pct >= 80 else None
                if level is None:
                    self.alerted.pop(key, None)   # window recovered — re-arm
                    continue
                if self.alerted.get(key) == level:
                    continue
                self.alerted[key] = level
                reset = s[win_key].get("quota_reset")
                body = (t["alert_done"] if level >= 100
                        else t["alert_reset"].format(reset=reset or "?"))
                subprocess.run(
                    ["notify-send", "-a", "Claude Stats",
                     "-i", str(ICON_PATH),
                     "-h", "string:desktop-entry:claude-stats-widget",
                     "-u", "critical" if level >= 95 else "normal",
                     t[f"alert_title_{key}"].format(pct=pct), body],
                    check=False)

        def on_heatmap_allocate(self, widget, alloc):
            """Keep cells square as the grid stretches to the card width."""
            gap = 2
            usable = alloc.width - gap * (HEATMAP_WEEKS - 1)
            # homogeneous columns round the width up, so round the height the
            # same way — otherwise the cells come out a pixel off square
            size = max(6, round(usable / HEATMAP_WEEKS))
            if size == self.heat_cell_px:
                return
            self.heat_cell_px = size
            for cell in self.heat_cells.values():
                cell.set_size_request(-1, size)   # width comes from the grid

        def update_heatmap(self):
            activity = {
                date.fromisoformat(k): v
                for k, v in self.stats.get("day_activity", {}).items()
            }
            peak = max(activity.values(), default=1) or 1
            today = date.today()
            # columns = weeks (oldest→newest), rows = Sun..Sat
            end_week_start = week_start(today)
            for col in range(HEATMAP_WEEKS):
                ws = end_week_start - timedelta(weeks=HEATMAP_WEEKS - 1 - col)
                for row in range(7):
                    d = ws + timedelta(days=row)
                    count = activity.get(d, 0) if d <= today else 0
                    level = 0 if count <= 0 else 1 + min(3, int(3 * count / peak))
                    ctx = self.heat_cells[(col, row)].get_style_context()
                    for lv in range(5):
                        ctx.remove_class(f"h{lv}")
                    ctx.add_class(f"h{level}")

        # ---------------------------------------------------- animation
        def pick_activity(self):
            # context first: he types along while a session is live, and
            # sulks once the weekly budget is gone
            if self.session_active and random.random() < 0.55:
                return ["type", random.randint(40, 90)]
            if (self.stats.get("week_quota_pct") or 0) >= 95 and random.random() < 0.22:
                return ["sad", random.randint(25, 50)]
            r = random.random()
            if r < 0.26:
                return ["walk", random.randint(50, 140)]
            if r < 0.36:
                return ["run", random.randint(30, 70)]
            if r < 0.46:
                return ["idle", random.randint(15, 40)]
            if r < 0.56:
                return ["look", 27]
            if r < 0.64:
                return ["wave", 24]
            if r < 0.72:
                return ["jump", 24]
            if r < 0.81:
                return ["exercise", 36]
            if r < 0.90:
                return ["flag", 40]
            if r < 0.96:
                return ["stomp", 26]
            return ["sleep", random.randint(40, 90)]

        def animate_big(self):
            if self.mode != "expanded" or not self.get_visible():
                return True
            self.anim_tick += 1
            if self.act[1] <= 0:
                self.act = self.pick_activity()
            self.act[1] -= 1
            name, left = self.act
            feet, eyes, arms, zzz, y = "idle", "open", None, 0, 2
            flag = laptop = 0
            confetti = -1
            flip = self.anim_dir < 0

            if name in ("walk", "run"):
                speed, swap = (2, 2) if name == "walk" else (5, 1)
                self.anim_x += speed * self.anim_dir
                width = max(self.anim_area.get_allocated_width(), 140)
                max_x = width - CANVAS_W * 5 - 4
                if self.anim_x <= 2:
                    self.anim_x, self.anim_dir = 2, 1
                elif self.anim_x >= max_x:
                    self.anim_x, self.anim_dir = max_x, -1
                feet = "walk1" if (self.anim_tick // swap) % 2 else "walk2"
                if name == "run":
                    arms = "mid"
                    y = 2 + (-1 if (self.anim_tick // swap) % 2 else 0)
            elif name == "idle":
                if self.anim_blink > 0:
                    self.anim_blink -= 1
                    eyes = "closed"
                elif random.random() < 0.07:
                    self.anim_blink = 2
                    eyes = "closed"
            elif name == "look":
                phase = 27 - left
                eyes = "left" if phase < 9 else "right" if phase < 18 else "open"
            elif name == "wave":
                arms = "up" if (self.anim_tick // 3) % 2 else "mid"
            elif name == "jump":
                phase = (24 - left) % len(JUMP_Y)
                y = 2 + JUMP_Y[phase]
                feet = "tuck" if y < 2 else "idle"
            elif name == "exercise":
                # jumping jacks: arms up + legs apart, then back together
                if (self.anim_tick // 3) % 2:
                    arms, feet, y = "both_up", "spread", 0
                else:
                    arms, feet, y = "both_mid", "idle", 2
            elif name == "flag":
                arms = "up"
                flag = 1 if (self.anim_tick // 3) % 2 else 2
            elif name == "stomp":
                phase = 26 - left
                if phase < len(JUMP_Y):
                    y = 2 + JUMP_Y[phase]
                    feet = "tuck" if y < 2 else "idle"
                else:
                    confetti = phase - len(JUMP_Y)
                    feet = "spread"
            elif name == "type":
                laptop = 2 if (self.anim_tick // 4) % 2 else 1
                arms, feet, flip = "mid", "tuck", False
                if random.random() < 0.05:
                    eyes = "closed"
            elif name == "sad":
                eyes, feet, y = "sad", "tuck", 4
            elif name == "sleep":
                eyes = "closed"
                zzz = 1 if (self.anim_tick // 5) % 2 else 2

            frame = self.frames_big.get(feet, eyes, arms, zzz, flag, laptop,
                                        confetti, flip=flip)
            self.clawd_big.set_from_pixbuf(frame)
            self.anim_area.move(self.clawd_big, int(self.anim_x), y)
            return True

        def animate_mini(self):
            if self.mode != "mini" or not self.get_visible():
                return True
            self.mini_tick += 1
            eyes, arms, y, feet, laptop = "open", None, 4, "idle", 0
            if self.session_active:
                # busy-but-calm: types along in the corner
                laptop = 2 if (self.mini_tick // 2) % 2 else 1
                arms, feet = "mid", "tuck"
                if random.random() < 0.08:
                    eyes = "closed"
            elif self.mini_wave > 0:
                self.mini_wave -= 1
                arms = "up" if self.mini_wave % 2 else "mid"
            elif self.mini_hop > 0:
                self.mini_hop -= 1
                y = 1
                feet = "tuck"
            elif (self.stats.get("week_quota_pct") or 0) >= 95 and random.random() < 0.15:
                eyes, feet = "sad", "tuck"
            elif random.random() < 0.10:
                eyes = "closed"
            elif random.random() < 0.03:
                self.mini_hop = 2
            elif random.random() < 0.02:
                self.mini_wave = 8
            self.clawd_mini.set_from_pixbuf(
                self.frames_mini.get(feet, eyes, arms, laptop=laptop))
            self.clawd_mini.get_parent().move(self.clawd_mini, 0, y)
            return True

    if not ICON_PATH.exists():
        write_icon()
    win = Widget()
    try:
        win.set_icon_from_file(str(ICON_PATH))
    except Exception:
        pass
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.stack.set_visible_child_name(win.mode)
    Gtk.main()


if __name__ == "__main__":
    if "--write-icon" in sys.argv:
        sys.exit(0 if write_icon() else 1)
    if "--json" in sys.argv:
        print(json.dumps(collect_stats(), ensure_ascii=False, indent=2))
    else:
        run_gui()
