CONFETTI_PHASES = 10


def _build_confetti():
    """Deterministic particle burst so frames stay cacheable."""
    rng = random.Random(7)
    seeds = []
    for _ in range(14):
        seeds.append((
            11 + rng.uniform(-2, 2), 4.0,          # start x, y
            rng.uniform(-1.1, 1.1), rng.uniform(-1.4, -0.5),  # vx, vy
            rng.choice("1234"),
        ))
    phases = []
    for p in range(CONFETTI_PHASES):
        cells = []
        for x0, y0, vx, vy, col in seeds:
            x = x0 + vx * p
            y = y0 + vy * p + 0.16 * p * p
            xi, yi = int(round(x)), int(round(y))
            if 0 <= xi < CANVAS_W and 0 <= yi < CANVAS_H and p < 9:
                cells.append((xi, yi, col))
        phases.append(cells)
    return phases


CONFETTI = _build_confetti()


def clawd_grid(feet="idle", eyes="open", arms=None, zzz=0, flag=0,
               laptop=0, confetti=-1):
    canvas = [["."] * CANVAS_W for _ in range(CANVAS_H)]

    body = [list(r) for r in CLAWD_BODY]
    if eyes == "closed":
        for c in (3, 4, 9, 10):
            body[4][c] = "D"
    elif eyes == "sad":
        for c in (3, 4, 9, 10):
            body[3][c] = "D"   # drooping lid
            body[4][c] = "B"
    else:
        lc, rc = EYE_POS[eyes]
        for r in (3, 4):
            for c in (lc, lc + 1, rc, rc + 1):
                body[r][c] = "B"

    for y, row in enumerate(body + [list(r) for r in FEET[feet]]):
        for x, ch in enumerate(row):
            if ch != ".":
                canvas[BODY_Y + y][BODY_X + x] = ch

    if arms:
        which = "both" if arms.startswith("both") else "right"
        pose = "up" if arms.endswith("up") else "mid"
        r1, r2 = ARM_ROWS[pose]
        cols = [ARM_R] + ([ARM_L] if which == "both" else [])
        for c in cols:
            canvas[r1][c] = canvas[r2][c] = "O"

    if flag:
        for r in range(1, ARM_ROWS["up"][0] + 1):
            canvas[r][ARM_R + 1] = "P"          # pole
        cloth_top = 1 if flag == 1 else 2       # two-frame wave
        for r in (cloth_top, cloth_top + 1):
            canvas[r][ARM_R + 2] = "F"
            canvas[r][ARM_R + 3] = "F"

    if laptop:
        screen = "T" if laptop == 2 else "S"
        for r in range(8, 11):
            for c in range(ARM_R, ARM_R + 3):
                canvas[r][c] = screen
        for c in range(ARM_R - 1, ARM_R + 4):
            canvas[11][c] = "L"

    if zzz >= 1:
        canvas[2][BODY_X + 12] = "Z"
    if zzz >= 2:
        canvas[1][BODY_X + 13] = "Z"

    if confetti >= 0:
        for x, y, col in CONFETTI[min(confetti, CONFETTI_PHASES - 1)]:
            if canvas[y][x] == ".":   # never punch holes in Clawd himself
                canvas[y][x] = col

    return ["".join(r) for r in canvas]


def _png_chunk(tag, payload):
    body = tag + payload
    return struct.pack(">I", len(payload)) + body + struct.pack(">I",
                                                                zlib.crc32(body))


def clawd_png(grid, cell):
    """Encode the pixel grid as an RGBA PNG, using nothing but the stdlib.

    Rendering the icon through a toolkit would mean the icon can only be
    written where that toolkit is installed — and on Windows there is none.
    Pixel art is a handful of solid rectangles, so encode it directly.
    """
    rgba = {}
    for ch, hexcol in CLAWD_COLORS.items():
        rgba[ch] = bytes.fromhex(hexcol[1:]) + b"\xff"
    transparent = b"\x00\x00\x00\x00"

    w, h = len(grid[0]) * cell, len(grid) * cell
    raw = bytearray()
    for row in grid:
        line = bytearray()
        for ch in row:
            line += rgba.get(ch, transparent) * cell
        for _ in range(cell):
            raw += b"\x00" + line          # filter type 0, one byte per scanline

    header = struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)   # 8-bit RGBA
    return (b"\x89PNG\r\n\x1a\n"
            + _png_chunk(b"IHDR", header)
            + _png_chunk(b"IDAT", zlib.compress(bytes(raw), 9))
            + _png_chunk(b"IEND", b""))


def icon_grid():
    """Clawd's face, cropped out of the animation canvas' empty margin."""
    return [row[3:19] for row in clawd_grid("idle", "open")[3:]]


def write_icon():
    """Render Clawd to a PNG (and on Windows an ICO) for launchers and toasts."""
    try:
        ICON_PATH.parent.mkdir(parents=True, exist_ok=True)
        ICON_PATH.write_bytes(clawd_png(icon_grid(), 16))    # 256x160
        if ICO_PATH is not None:
            # A square ICO: Windows scales the entry to whatever size the
            # shell asks for, but it will not letterbox a non-square one.
            grid = icon_grid()
            pad = (len(grid[0]) - len(grid)) // 2
            square = ([("." * len(grid[0]))] * pad + grid
                      + [("." * len(grid[0]))] * (len(grid[0]) - len(grid) - pad))
            png = clawd_png(square, 16)
            # Vista+ reads a PNG-compressed icon entry directly.
            ico = struct.pack("<HHH", 0, 1, 1) + struct.pack(
                "<BBBBHHII", 0, 0, 0, 0, 1, 32, len(png), 22)
            ICO_PATH.write_bytes(ico + png)
        return True
    except OSError:
        return False    # a missing icon must never stop the widget


def clawd_svg(grid, cell):
    w, h = len(grid[0]) * cell, len(grid) * cell
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" '
             f'shape-rendering="crispEdges">']
    for y, row in enumerate(grid):
        for x, ch in enumerate(row):
            color = CLAWD_COLORS.get(ch)
            if color:
                parts.append(f'<rect x="{x * cell}" y="{y * cell}" '
                             f'width="{cell}" height="{cell}" fill="{color}"/>')
    parts.append("</svg>")
    return "".join(parts).encode()


# ------------------------------------------------------------------ config

def default_lang():
    """English by default; Hebrew only if the desktop itself runs in Hebrew."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if (os.environ.get(var) or "").lower().startswith("he"):
            return "he"
    if IS_WINDOWS:
        # Windows sets none of those; ask the shell for the UI language.
        try:
            import ctypes
            lang = ctypes.windll.kernel32.GetUserDefaultUILanguage() & 0x3FF
            if lang == 0x0D:        # LANG_HEBREW
                return "he"
        except (OSError, AttributeError, ValueError):
            pass
    return "en"


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, ensure_ascii=False)
    except OSError:
        pass


def update_config(**changes):
    """Merge onto what is on disk right now.

    Writing a whole in-memory dict would clobber keys another process wrote
    meanwhile — that is exactly how a calibration got lost once.
    """
    cfg = load_config()
    cfg.update(changes)
    save_config(cfg)
    return cfg


def newest_transcript_mtime():
    newest = 0.0
    for jf in PROJECTS_DIR.glob("*/*.jsonl"):
        if is_poll_dir(jf.parent.name):
            continue
        try:
            newest = max(newest, jf.stat().st_mtime)
        except OSError:
            continue
    return newest


def script_mtime():
    try:
        return SCRIPT_PATH.stat().st_mtime
    except OSError:
        return None


def restart_process():
    """Relaunch into the script on disk, after an upgrade rewrote it.

    Never exec into a half-written or broken file: a mid-edit save once killed
    the widget outright. Compile first, and if it does not parse, keep running
    the code already in memory.
    """
    try:
        compile(SCRIPT_PATH.read_text(encoding="utf-8"), str(SCRIPT_PATH),
                "exec")
    except (SyntaxError, OSError, ValueError):
        return False
    # nothing to persist here: every setting is written when it changes
    if IS_WINDOWS:
        # Windows has no real exec: os.execv leaves the old process id behind
        # and returns control to a half-torn-down interpreter. Spawn and go.
        subprocess.Popen([sys.executable, str(SCRIPT_PATH)],
                         close_fds=True, **NO_WINDOW)
        os._exit(0)
    os.execv(sys.executable, [sys.executable, str(SCRIPT_PATH)])
    return True


