def default_lang():
    """English by default; Hebrew only if the desktop itself runs in Hebrew."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if (os.environ.get(var) or "").lower().startswith("he"):
            return "he"
    return "en"


def load_config():
    try:
        with open(CONFIG_PATH, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_config(cfg):
    try:
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with open(CONFIG_PATH, "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, ensure_ascii=False)
    except OSError:
        pass


def update_config(**changes):
    """Merge onto what is on disk right now.

    Writing a whole in-memory dict would clobber keys another process wrote
    meanwhile — that is exactly how a calibration got lost once.
    """
    cfg = load_config()
    cfg.update(changes)
    save_config(cfg)
    return cfg


def newest_transcript_mtime():
    newest = 0.0
    for jf in PROJECTS_DIR.glob("*/*.jsonl"):
        if jf.parent.name == POLL_PROJECT:
            continue
        try:
            newest = max(newest, jf.stat().st_mtime)
        except OSError:
            continue
    return newest


