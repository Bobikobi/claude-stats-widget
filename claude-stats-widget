    .h0 { background-color: #3c3c3a; border-radius: 2px; }
    .h1 { background-color: #4a5a8c; border-radius: 2px; }
    .h2 { background-color: #4568b8; border-radius: 2px; }
    .h3 { background-color: #3d6bf2; border-radius: 2px; }
    .h4 { background-color: #4f78ff; border-radius: 2px; }
    levelbar trough { background-color: #3c3c3a; border-radius: 5px;
                      min-height: 9px; border: none; }
    levelbar block { border-radius: 5px; min-height: 9px; border: none; }
    levelbar block.filled.calm { background-color: #6fbf73; }
    levelbar block.filled.warn { background-color: #e8a34c; }
