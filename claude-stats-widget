    def make_pixbuf(grid, cell):
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.write(clawd_svg(grid, cell))
        loader.close()
        return loader.get_pixbuf()

    class FrameCache:
        def __init__(self, cell):
            self.cell = cell
            self.cache = {}

        def get(self, feet="idle", eyes="open", arms=None, zzz=0, flag=0,
                laptop=0, confetti=-1, flip=False):
            key = (feet, eyes, arms, zzz, flag, laptop, confetti, flip)
            if key not in self.cache:
                pb = make_pixbuf(
                    clawd_grid(feet, eyes, arms, zzz, flag, laptop, confetti),
                    self.cell)
                self.cache[key] = pb.flip(True) if flip else pb
            return self.cache[key]

    JUMP_Y = [0, -3, -6, -8, -6, -3, 0, 0]

    def make_meter():
        bar = Gtk.LevelBar.new_for_interval(0, 100)
        bar.set_hexpand(True)
        bar.add_offset_value("calm", 50)   # 0-50%  green
        bar.add_offset_value("warn", 80)   # 50-80% amber
        bar.add_offset_value("crit", 100)  # 80-100% red
        return bar

