POLL_PROJECT = re.sub(r"[/\\:.]", "-", str(POLL_DIR))


POLL_SUFFIX = "claude-stats-widget-poll"


def is_poll_dir(name):
    """True for the project folder our own /usage polling writes into.

    The exact flattening rule is Claude Code's, not ours, so do not stake the
    whole thing on reproducing it — a case-folded drive letter is enough to
    make the slug miss, and then the widget quietly counts its own polling as
    your usage. Fall back on the folder's tail instead. Matching merely on the
    app's name would be too greedy: a real session opened inside a checkout of
    this repo lands in a folder named after it, and those transcripts are
    yours — they get counted, and they never get deleted.
    """
    low = name.lower()
    return low == POLL_PROJECT.lower() or low.endswith(POLL_SUFFIX)


