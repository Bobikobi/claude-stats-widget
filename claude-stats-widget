# Windows PowerShell, explicitly: the WinRT type accelerators below do not
# load in PowerShell 7, and `pwsh` is what wins a bare PATH lookup here.
_POWERSHELL = str(Path(os.environ.get("SystemRoot", r"C:\Windows"))
                  / "System32" / "WindowsPowerShell" / "v1.0" / "powershell.exe")
# Toasts are attributed to an app, and an unregistered AppUserModelID is
# silently dropped. Borrow PowerShell's own registered id rather than write to
# the registry — a usage widget has no business installing a shell identity.
_TOAST_APPID = (r"{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}"
                r"\WindowsPowerShell\v1.0\powershell.exe")
# A WinRT type literal may not be wrapped: PowerShell's parser wants the
# closing bracket on the line it opened.
_TOAST_PS = """
$ErrorActionPreference = 'Stop'
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > $null
[Windows.Data.Xml.Dom.XmlDocument, Windows.Data.Xml.Dom, ContentType = WindowsRuntime] > $null
$xml = New-Object Windows.Data.Xml.Dom.XmlDocument
$xml.LoadXml($env:CSW_TOAST_XML)
$toast = New-Object Windows.UI.Notifications.ToastNotification $xml
$notifier = [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($env:CSW_TOAST_APPID)
$notifier.Show($toast)
"""


def _xml_escape(text):
    return (str(text).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def notify(title, body, critical=False):
    """Raise a desktop notification, or do nothing at all if we cannot.

    A widget that reports on your quota must never itself become the reason a
    session dies, so every failure here is swallowed.
    """
    try:
        if IS_WINDOWS:
            logo = ""
            if ICON_PATH.exists():
                logo = ('<image placement="appLogoOverride" src="%s"/>'
                        % _xml_escape(ICON_PATH.as_uri()))
            xml = ('<toast scenario="%s"><visual><binding '
                   'template="ToastGeneric">%s<text>%s</text><text>%s</text>'
                   "</binding></visual></toast>"
                   % ("reminder" if critical else "default", logo,
                      _xml_escape(title), _xml_escape(body)))
            env = dict(os.environ, CSW_TOAST_XML=xml,
                       CSW_TOAST_APPID=_TOAST_APPID)
            subprocess.run([_POWERSHELL, "-NoProfile", "-NonInteractive",
                            "-Command", _TOAST_PS],
                           env=env, capture_output=True, timeout=20,
                           check=False, **NO_WINDOW)
        else:
            subprocess.run(
                ["notify-send", "-a", "Claude Stats", "-i", str(ICON_PATH),
                 "-h", "string:desktop-entry:claude-stats-widget",
                 "-u", "critical" if critical else "normal", title, body],
                check=False)
    except (OSError, subprocess.SubprocessError):
        pass
SESSION_RE = re.compile(r"Current session:\s*(\d+)%\s*used[^\n]*?resets\s*([^(\n]+)")
WEEK_RE = re.compile(r"Current week[^:\n]*:\s*(\d+)%\s*used[^\n]*?resets\s*([^(\n]+)")


def parse_usage(text):
    """Pull the real percentages out of what `/usage` prints."""
    out = {"at": time.time()}
    m = SESSION_RE.search(text)
    if m:
        out["session_pct"] = int(m.group(1))
        out["session_reset"] = m.group(2).strip()
    m = WEEK_RE.search(text)
    if m:
        out["week_pct"] = int(m.group(1))
        out["week_reset"] = m.group(2).strip()
    return out if "session_pct" in out or "week_pct" in out else None


def log_poll_failure(why):
    """Leave a trace when a poll comes back empty.

    A silent failure is indistinguishable from a quiet week: the number on
    screen simply stops moving, with nothing anywhere to say why.
    """
    line = f"{datetime.now().isoformat(timespec='seconds')} {why}\n"
    try:
        with POLL_LOG.open("a", encoding="utf-8") as fh:
            fh.write(line)
        if POLL_LOG.stat().st_size > 64_000:
            POLL_LOG.write_text(
                POLL_LOG.read_text(encoding="utf-8")[-32_000:], encoding="utf-8")
    except OSError:
        pass


def poll_usage():
    """Ask Claude Code itself for the quota.

    Verified free: `/usage` is handled client-side, so the call reports
    num_turns 0 and total_cost_usd 0. Runs headless, no window.
    """
    cli = claude_cli()
    if not cli:
        return None      # no CLI, no real quota — the meters fall back cleanly
    try:
        POLL_DIR.mkdir(parents=True, exist_ok=True)
        proc = subprocess.run(
            [cli, "-p", "/usage", "--output-format", "json"],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
            timeout=90, cwd=str(POLL_DIR), **NO_WINDOW)
        data = json.loads(proc.stdout)
    except Exception as exc:
        log_poll_failure(f"{type(exc).__name__}: {exc}")
        return None
    finally:
        clear_poll_transcripts()
    report = parse_usage(data.get("result") or "")
    if not report:
        said = str(data.get("result") or proc.stderr or "")[:200]
        log_poll_failure("no percentages in the answer: " + " ".join(said.split()))
        return None
    try:
        USAGE_CACHE.parent.mkdir(parents=True, exist_ok=True)
        USAGE_CACHE.write_text(json.dumps(report), encoding="utf-8")
    except OSError as exc:
        log_poll_failure(f"could not write the cache: {exc}")
    return report


def clear_poll_transcripts():
    """Delete the throwaway sessions our own polling just created."""
    for jf in PROJECTS_DIR.glob("*/*.jsonl"):
        if not is_poll_dir(jf.parent.name):
            continue
        try:
            jf.unlink()
        except OSError:
            pass


def load_usage_cache():
    """The last answer /usage gave us, while it can still be true.

    Past USAGE_MAX_AGE we drop it and fall back to the local time-based
    reading, which is rougher but never claims you are blocked when you
    are not.
    """
    try:
        report = json.loads(USAGE_CACHE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if time.time() - (report.get("at") or 0) > USAGE_MAX_AGE:
        return None
    return report


def week_start(today):
    """Sunday-based week, matching the heatmap's column layout."""
    return today - timedelta(days=(today.weekday() + 1) % 7)


def block_reset(timeline, seconds, now_ts):
    """When the current usage window rolls over.

    Claude's windows are not rolling averages: one opens with your first
    message and closes `seconds` later. Walk the timeline and keep the last
    block that is still open.
    """
    start = None
    for ts, _ in timeline:
        if start is None or ts >= start + seconds:
            start = ts
    if start is None:
        return None
    reset = start + seconds
    return reset if reset > now_ts else None


def collect_stats():
    sessions = set()
    raw_messages = 0      # every user/assistant entry, exactly as the app counts
    raw_tokens = 0        # summed over every assistant entry, duplicates included
    user_msgs = 0
    assistant_seen = {}  # message id -> (tokens, model, when)
    day_activity = Counter()
    hour_counter = Counter()
    model_counter = Counter()

    for jf in PROJECTS_DIR.glob("*/*.jsonl"):
        if is_poll_dir(jf.parent.name):
            continue        # our own /usage polls, not real sessions
        try:
            with open(jf, encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    try:
                        obj = json.loads(line)
                    except (json.JSONDecodeError, ValueError):
                        continue
                    typ = obj.get("type")
                    if typ not in ("user", "assistant"):
                        continue
                    raw_messages += 1
                    if typ == "assistant":
                        _u = (obj.get("message") or {}).get("usage") or {}
                        raw_tokens += (_u.get("input_tokens", 0) or 0) + \
                                      (_u.get("output_tokens", 0) or 0)
                    if obj.get("isMeta"):
                        continue
                    ts = obj.get("timestamp")
                    try:
                        when = datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
                    except (AttributeError, ValueError):
                        continue
                    msg = obj.get("message") or {}

                    if typ == "user":
                        content = msg.get("content")
                        # skip tool results and local-command wrappers
                        if isinstance(content, list):
                            if any(isinstance(c, dict) and c.get("type") == "tool_result" for c in content):
                                continue
                            content = " ".join(
                                c.get("text", "") for c in content if isinstance(c, dict)
                            )
                        if not isinstance(content, str) or content.lstrip().startswith("<"):
                            continue
                        user_msgs += 1
                        sid = obj.get("sessionId")
                        if sid:
                            sessions.add(sid)
                        day_activity[when.date()] += 1
                        hour_counter[when.hour] += 1
                    else:
                        mid = msg.get("id")
                        usage = msg.get("usage") or {}
                        # matches the app's "Total tokens": input + output,
                        # cache reads/writes excluded
                        tokens = (
                            usage.get("input_tokens", 0)
                            + usage.get("output_tokens", 0)
                        )
                        model = msg.get("model")
                        if mid:
                            # streaming writes the same message id repeatedly;
                            # keep the largest usage snapshot
                            prev = assistant_seen.get(mid)
                            if prev is None or tokens > prev[0]:
                                assistant_seen[mid] = (tokens, model, when)
                        else:
                            assistant_seen[f"{jf.name}:{when.timestamp()}"] = (
                                tokens, model, when)
        except OSError:
            continue

    total_tokens = 0
    assistant_msgs = 0
    timeline = []  # message timestamps, for locating window boundaries
    for tokens, model, when in assistant_seen.values():
        total_tokens += tokens
        assistant_msgs += 1
        if model:
            model_counter[model] += 1
        timeline.append((when.timestamp(), 0.0))
        day_activity[when.date()] += 0  # ensure day exists even w/o user msg
    timeline.sort()

    active_days = sorted(d for d, c in day_activity.items() if c > 0)

    # streaks
    current_streak = 0
    today = date.today()
    d = today
    active_set = set(active_days)
    if today not in active_set and (today - timedelta(days=1)) in active_set:
        d = today - timedelta(days=1)
    while d in active_set:
        current_streak += 1
        d -= timedelta(days=1)

    longest_streak = 0
    run = 0
    prev = None
    for d in active_days:
        run = run + 1 if prev is not None and (d - prev).days == 1 else 1
        longest_streak = max(longest_streak, run)
        prev = d

    peak_hour = hour_counter.most_common(1)[0][0] if hour_counter else None
    fav_model = model_counter.most_common(1)[0][0] if model_counter else None

    now_ts = datetime.now().astimezone().timestamp()
    report = load_usage_cache()
    windows = {}
    for key, seconds in (("5h", 5 * 3600), ("7d", 7 * 86400)):
        windows[key] = {
            "window_seconds": seconds,
            # fallback only: when the real quota is unavailable, show how far
            # the current window has run
            "resets_at": block_reset(timeline, seconds, now_ts),
            # the real thing, straight from the server via `/usage`
            "quota_pct": (report or {}).get(
                "session_pct" if key == "5h" else "week_pct"),
            "quota_reset": (report or {}).get(
                "session_reset" if key == "5h" else "week_reset"),
            "quota_age_min": (int((now_ts - report["at"]) / 60)
                              if report else None),
        }

    return {
        "window_5h": windows["5h"],
        "window_7d": windows["7d"],
        "sessions": len(sessions),
        "messages": raw_messages,
        "total_tokens": raw_tokens,
        "unique_messages": user_msgs + assistant_msgs,
        "deduped_tokens": total_tokens,
        "active_days": len(active_days),
        "current_streak": current_streak,
        "longest_streak": longest_streak,
        "peak_hour": peak_hour,
        "favorite_model": pretty_model(fav_model),
        "day_activity": {d.isoformat(): c for d, c in day_activity.items()},
        "session_quota_pct": windows["5h"]["quota_pct"],
        "week_quota_pct": windows["7d"]["quota_pct"],
    }


def fmt_countdown(seconds, lang):
    """H:MM under a day, days+hours above it."""
    if seconds >= 86400:
        d, rem = divmod(seconds, 86400)
        h = rem // 3600
        return f"{d}d {h}h" if lang == "en" else f"{d}י {h}ש"
    h, rem = divmod(seconds, 3600)
    return f"{h}:{rem // 60:02d}"


def fmt_hour(h):
    if h is None:
        return "—"
    suffix = "AM" if h < 12 else "PM"
    h12 = h % 12 or 12
    return f"{h12} {suffix}"


def hp_line(total, lang):
    ratio = total / HP_TOKENS
    if ratio < 0.1:
        return TR[lang]["hp_low"]
    return TR[lang]["hp"].format(r=ratio)


def alert_messages(stats, alerted, lang):
    """Warn before a window runs out, not after.

    `alerted` is the caller's memory of what has already fired, and is updated
    in place: each threshold notifies once, and re-arms only when the quota
    actually recovers.
    """
    t = TR[lang]
    out = []
    for key, pct_key, win_key in (("hour5", "session_quota_pct", "window_5h"),
                                  ("week", "week_quota_pct", "window_7d")):
        pct = stats.get(pct_key)
        if pct is None:
            continue    # no real number yet, nothing worth warning about
        level = (100 if pct >= 100 else 95 if pct >= 95
                 else 80 if pct >= 80 else None)
        if level is None:
            alerted.pop(key, None)   # window recovered — re-arm
            continue
        if alerted.get(key) == level:
            continue
        alerted[key] = level
        reset = (stats.get(win_key) or {}).get("quota_reset")
        body = (t["alert_done"] if level >= 100
                else t["alert_reset"].format(reset=reset or "?"))
        out.append((t[f"alert_title_{key}"].format(pct=pct), body, level >= 95))
    return out


# ------------------------------------------------------- Clawd's activities
# Which pose Clawd strikes is a decision, not a drawing, so it lives here
# rather than in either toolkit — the GTK and Tk builds share one engine and
# cannot drift into being two different characters.

JUMP_Y = [0, -3, -6, -8, -6, -3, 0, 0]


class ClawdEngine:
    """The full-size strip: Clawd walks, works, plays and sulks."""

    def __init__(self):
        self.x = 10.0
        self.dir = 1
        self.tick = 0
        self.blink = 0
        self.act = ["walk", 60]

    def pick_activity(self, session_active, week_pct):
        # context first: he types along while a session is live, and sulks
        # once the weekly budget is gone
        if session_active and random.random() < 0.55:
            return ["type", random.randint(40, 90)]
        if week_pct >= 95 and random.random() < 0.22:
            return ["sad", random.randint(25, 50)]
        r = random.random()
        if r < 0.26:
            return ["walk", random.randint(50, 140)]
        if r < 0.36:
            return ["run", random.randint(30, 70)]
        if r < 0.46:
            return ["idle", random.randint(15, 40)]
        if r < 0.56:
            return ["look", 27]
        if r < 0.64:
            return ["wave", 24]
        if r < 0.72:
            return ["jump", 24]
        if r < 0.81:
            return ["exercise", 36]
        if r < 0.90:
            return ["flag", 40]
        if r < 0.96:
            return ["stomp", 26]
        return ["sleep", random.randint(40, 90)]

    def step(self, width, cell, session_active, week_pct):
        """Advance one frame. Returns (frame kwargs, x, y) in pixels."""
        self.tick += 1
        if self.act[1] <= 0:
            self.act = self.pick_activity(session_active, week_pct)
        self.act[1] -= 1
        name, left = self.act
        feet, eyes, arms, zzz, y = "idle", "open", None, 0, 2
        flag = laptop = 0
        confetti = -1
        flip = self.dir < 0

        if name in ("walk", "run"):
            speed, swap = (2, 2) if name == "walk" else (5, 1)
            self.x += speed * self.dir
            max_x = max(width, 140) - CANVAS_W * cell - 4
            if self.x <= 2:
                self.x, self.dir = 2, 1
            elif self.x >= max_x:
                self.x, self.dir = max_x, -1
            feet = "walk1" if (self.tick // swap) % 2 else "walk2"
            if name == "run":
                arms = "mid"
                y = 2 + (-1 if (self.tick // swap) % 2 else 0)
        elif name == "idle":
            if self.blink > 0:
                self.blink -= 1
                eyes = "closed"
            elif random.random() < 0.07:
                self.blink = 2
                eyes = "closed"
        elif name == "look":
            phase = 27 - left
            eyes = "left" if phase < 9 else "right" if phase < 18 else "open"
        elif name == "wave":
            arms = "up" if (self.tick // 3) % 2 else "mid"
        elif name == "jump":
            phase = (24 - left) % len(JUMP_Y)
            y = 2 + JUMP_Y[phase]
            feet = "tuck" if y < 2 else "idle"
        elif name == "exercise":
            # jumping jacks: arms up + legs apart, then back together
            if (self.tick // 3) % 2:
                arms, feet, y = "both_up", "spread", 0
            else:
                arms, feet, y = "both_mid", "idle", 2
        elif name == "flag":
            arms = "up"
            flag = 1 if (self.tick // 3) % 2 else 2
        elif name == "stomp":
            phase = 26 - left
            if phase < len(JUMP_Y):
                y = 2 + JUMP_Y[phase]
                feet = "tuck" if y < 2 else "idle"
            else:
                confetti = phase - len(JUMP_Y)
                feet = "spread"
        elif name == "type":
            laptop = 2 if (self.tick // 4) % 2 else 1
            arms, feet, flip = "mid", "tuck", False
            if random.random() < 0.05:
                eyes = "closed"
        elif name == "sad":
            eyes, feet, y = "sad", "tuck", 4
        elif name == "sleep":
            eyes = "closed"
            zzz = 1 if (self.tick // 5) % 2 else 2

        return (dict(feet=feet, eyes=eyes, arms=arms, zzz=zzz, flag=flag,
                     laptop=laptop, confetti=confetti, flip=flip),
                int(self.x), y)


class MiniClawdEngine:
    """The corner of the cube: the same character, doing much less."""

    def __init__(self):
        self.tick = 0
        self.hop = 0
        self.wave = 0

    def step(self, session_active, week_pct):
        self.tick += 1
        eyes, arms, y, feet, laptop = "open", None, 4, "idle", 0
        if session_active:
            # busy-but-calm: types along in the corner
            laptop = 2 if (self.tick // 2) % 2 else 1
            arms, feet = "mid", "tuck"
            if random.random() < 0.08:
                eyes = "closed"
        elif self.wave > 0:
            self.wave -= 1
            arms = "up" if self.wave % 2 else "mid"
        elif self.hop > 0:
            self.hop -= 1
            y = 1
            feet = "tuck"
        elif week_pct >= 95 and random.random() < 0.15:
            eyes, feet = "sad", "tuck"
        elif random.random() < 0.10:
            eyes = "closed"
        elif random.random() < 0.03:
            self.hop = 2
        elif random.random() < 0.02:
            self.wave = 8
        return dict(feet=feet, eyes=eyes, arms=arms, laptop=laptop), y


