            self.heatmap.set_column_homogeneous(True)
            self.heatmap.connect("size-allocate", self.on_heatmap_allocate)
            self.heat_cell_px = 0
            self.heat_cells = {}
            for col in range(HEATMAP_WEEKS):
                for row in range(7):
                    cell = Gtk.Box()
                    cell.set_hexpand(True)
                    cell.set_size_request(11, 11)
                    cell.get_style_context().add_class("h0")
                    self.heatmap.attach(cell, col, row, 1, 1)
                    self.heat_cells[(col, row)] = cell
            outer.pack_start(self.heatmap, False, False, 0)

            # Clawd's walking strip
            self.anim_area = Gtk.Fixed()
            self.anim_area.set_size_request(-1, 72)
            self.anim_area.set_direction(Gtk.TextDirection.LTR)
            self.clawd_big = Gtk.Image.new_from_pixbuf(self.frames_big.get())
            self.anim_area.put(self.clawd_big, 10, 2)
            outer.pack_start(self.anim_area, False, False, 0)

            self.footer = Gtk.Label(label="")
            self.footer.get_style_context().add_class("footer")
            self.footer.set_halign(Gtk.Align.START)
            self.footer.set_line_wrap(True)
            outer.pack_start(self.footer, False, False, 0)

            self.stack.add_named(outer, "expanded")

        def build_mini(self):
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            outer.get_style_context().add_class("card-mini")
            for m in ("top", "bottom", "start", "end"):
                getattr(outer, f"set_margin_{m}")(4)
            outer.set_size_request(170, -1)

            top = Gtk.Box(spacing=4)
            # Clawd lives in the corner of the cube
            corner = Gtk.Fixed()
            corner.set_size_request(46, 32)
            corner.set_direction(Gtk.TextDirection.LTR)
            self.clawd_mini = Gtk.Image.new_from_pixbuf(self.frames_mini.get())
            corner.put(self.clawd_mini, 0, 4)
            top.pack_start(corner, False, False, 0)

            brand = Gtk.Label(label="Claude")
            brand.get_style_context().add_class("brand")
            brand.set_halign(Gtk.Align.START)
            top.pack_start(brand, True, True, 0)

            expand_btn = Gtk.Button(label="⤢")
            expand_btn.get_style_context().add_class("headerbtn")
            expand_btn.set_relief(Gtk.ReliefStyle.NONE)
            expand_btn.set_valign(Gtk.Align.START)
            expand_btn.connect("clicked", lambda *_: self.set_mode("expanded"))
            top.pack_end(expand_btn, False, False, 0)

            mini_refresh = Gtk.Button(label="\u27f3")
            mini_refresh.get_style_context().add_class("headerbtn")
            mini_refresh.set_relief(Gtk.ReliefStyle.NONE)
            mini_refresh.set_valign(Gtk.Align.START)
            mini_refresh.connect("clicked", self.on_manual_refresh)
            top.pack_end(mini_refresh, False, False, 0)
            outer.pack_start(top, False, False, 0)

            self.mini_meters = {}
            for key in ("hour5", "week"):
                row = Gtk.Box(spacing=4)
                lab = Gtk.Label()
                lab.get_style_context().add_class("meter-label")
                lab.set_halign(Gtk.Align.START)
                pct = Gtk.Label()
                pct.get_style_context().add_class("meter-pct")
                row.pack_start(lab, True, True, 0)
                row.pack_end(pct, False, False, 0)
                bar = make_meter()
                outer.pack_start(row, False, False, 0)
                outer.pack_start(bar, False, False, 0)
                self.mini_meters[key] = (lab, pct, bar)

            self.stack.add_named(outer, "mini")

        # ------------------------------------------------------- behavior
        def set_mode(self, mode, first=False):
            self.mode = mode
            self.stack.set_visible_child_name(mode)
            if not first:
                self.config = update_config(mode=mode)
            self.resize(1, 1)  # shrink window to fit the visible page

        def apply_direction(self):
            direction = (Gtk.TextDirection.RTL if self.lang == "he"
                         else Gtk.TextDirection.LTR)
            Gtk.Widget.set_default_direction(direction)

        def apply_language(self):
            t = TR[self.lang]
            self.title_label.set_text(t["title"])
            self.lang_btn.set_label(t["toggle"])
            for key in STAT_KEYS:
                self.tile_labels[key].set_text(t[key])
            self.tick_countdown()
            for key in self.full_meters:   # re-applied per refresh as well
                pass
            if self.stats:
                self.footer.set_text(hp_line(self.stats["total_tokens"], self.lang))

        def on_manual_refresh(self, btn):
            btn.set_sensitive(False)
            self.refresh()
            # brief disable so a double-click cannot queue two full rescans
            GLib.timeout_add(400, lambda: btn.set_sensitive(True) or False)

        def on_toggle_lang(self, _btn):
            self.lang = "en" if self.lang == "he" else "he"
            self.config = update_config(lang=self.lang)
            self.apply_direction()
            self.apply_language()
            self.queue_resize()

        def on_press(self, _w, event):
            if event.button == 1:
                self.begin_move_drag(1, int(event.x_root), int(event.y_root),
                                     event.time)
            return False

        def on_key(self, _w, event):
            if event.keyval == Gdk.KEY_Escape:
                Gtk.main_quit()
            return False

        # --------------------------------------------------------- data
        def watch(self):
            """Cheap tick: notice live sessions, fresh data and new code."""
            newest = newest_transcript_mtime()
            was_active = self.session_active
            self.session_active = (time.time() - newest) < ACTIVE_WINDOW
            # a live session changes the numbers fast — refresh right away
            if self.session_active and newest > self.last_seen_mtime:
                self.last_seen_mtime = newest
                self.refresh()
            elif was_active and not self.session_active:
                self.refresh()
            # the script rewrote itself (an upgrade) — restart into it
            mtime = script_mtime()
            if mtime and self.script_mtime and mtime != self.script_mtime:
                self.restart()
            return True

        def restart(self):
            restart_process()

        def refresh(self):
            try:
                self.stats = collect_stats()
            except Exception as exc:  # keep the widget alive on parse errors
                self.footer.set_text(TR[self.lang]["err"].format(e=exc))
                return True
            s = self.stats
            self.tiles["sessions"].set_text(str(s["sessions"]))
            self.tiles["messages"].set_text(str(s["messages"]))
            self.tiles["total_tokens"].set_text(fmt_num(s["total_tokens"]))
            self.tiles["active_days"].set_text(str(s["active_days"]))
            self.tiles["current_streak"].set_text(f'{s["current_streak"]}d')
            self.tiles["longest_streak"].set_text(f'{s["longest_streak"]}d')
            self.tiles["peak_hour"].set_text(fmt_hour(s["peak_hour"]))
            self.tiles["favorite_model"].set_text(s["favorite_model"])
            self.footer.set_text(hp_line(s["total_tokens"], self.lang))
            self.tick_countdown()
            self.check_alerts(s)
            self.update_heatmap()
            return True  # keep the GLib timer running

        def spawn_usage_poll(self):
            """Refresh the real quota off-thread so the UI never stalls."""
            if self.polling:
                return True
            self.polling = True

            def work():
                report = poll_usage()
                def done():
                    self.polling = False
                    if report:
                        self.refresh()
                    return False
                GLib.idle_add(done)

            threading.Thread(target=work, daemon=True).start()
            return True

        def tick_countdown(self):
            """Second-by-second countdown to each window's reset."""
            if not self.stats:
                return True
            t = TR[self.lang]
            now = time.time()
            for key, win_key in (("hour5", "window_5h"), ("week", "window_7d")):
                win = self.stats.get(win_key) or {}
                resets = win.get("resets_at")
                span = win.get("window_seconds") or 1
                if resets:
                    left = max(0, int(resets - now))
                    elapsed = 100.0 * (1 - left / span)
                    countdown = fmt_countdown(left, self.lang)
                else:
                    # no open window: the session is over, quota is fresh
                    left, elapsed, countdown = 0, 100.0, t["fresh"]

                quota = win.get("quota_pct")
                real_quota = quota is not None
                if real_quota:
                    # the honest meter: how much of the quota is gone,
                    # straight from the server's own answer to /usage
                    elapsed = float(quota)
                    text = f"{quota:.0f}%"
                    tip = t["tip_quota"].format(age=win.get("quota_age_min") or 0,
                                                reset=win.get("quota_reset") or "?")
                elif key == "hour5":
                    text = f"{elapsed:.0f}%"
                    tip = t["tip_session"].format(left=countdown)
                else:
                    text = countdown
                    tip = t["tip_countdown"]
                for meters in (self.full_meters, self.mini_meters):
                    if key not in meters:
                        continue
                    lab, val, bar = meters[key]
                    lab.set_text(t[f"{key}_short" if meters is self.mini_meters
                                   else (f"{key}_quota" if real_quota
                                         else f"{key}_reset")])
                    val.set_text(text)
                    bar.set_value(max(0.0, min(100.0, elapsed)))
                    ctx = bar.get_style_context()
                    # real quota gets the warning colours; time progress stays
                    # neutral, because a session ending is not a danger
                    (ctx.remove_class if real_quota else ctx.add_class)("recordbar")
                    bar.set_tooltip_text(tip)
            return True

        def meter_tooltip(self, key, s):
            """Say plainly what this bar's 100% actually means."""
            t = TR[self.lang]
            return t["tip_countdown"]

        def check_alerts(self, s):
            for title, body, critical in alert_messages(s, self.alerted,
                                                        self.lang):
                notify(title, body, critical)

        def on_heatmap_allocate(self, widget, alloc):
            """Keep cells square as the grid stretches to the card width."""
            gap = 2
            usable = alloc.width - gap * (HEATMAP_WEEKS - 1)
            # homogeneous columns round the width up, so round the height the
            # same way — otherwise the cells come out a pixel off square
            size = max(6, round(usable / HEATMAP_WEEKS))
            if size == self.heat_cell_px:
                return
            self.heat_cell_px = size
            for cell in self.heat_cells.values():
                cell.set_size_request(-1, size)   # width comes from the grid

        def update_heatmap(self):
            activity = {
                date.fromisoformat(k): v
                for k, v in self.stats.get("day_activity", {}).items()
            }
            peak = max(activity.values(), default=1) or 1
            today = date.today()
            # columns = weeks (oldest→newest), rows = Sun..Sat
            end_week_start = week_start(today)
            for col in range(HEATMAP_WEEKS):
                ws = end_week_start - timedelta(weeks=HEATMAP_WEEKS - 1 - col)
                for row in range(7):
                    d = ws + timedelta(days=row)
                    count = activity.get(d, 0) if d <= today else 0
                    level = 0 if count <= 0 else 1 + min(3, int(3 * count / peak))
                    ctx = self.heat_cells[(col, row)].get_style_context()
                    for lv in range(5):
                        ctx.remove_class(f"h{lv}")
                    ctx.add_class(f"h{level}")

        # ---------------------------------------------------- animation
        def animate_big(self):
            if self.mode != "expanded" or not self.get_visible():
                return True
            kw, x, y = self.clawd.step(
                self.anim_area.get_allocated_width(), 5,
                self.session_active, self.stats.get("week_quota_pct") or 0)
            self.clawd_big.set_from_pixbuf(self.frames_big.get(**kw))
            self.anim_area.move(self.clawd_big, x, y)
            return True

        def animate_mini(self):
            if self.mode != "mini" or not self.get_visible():
                return True
            kw, y = self.clawd_mini_engine.step(
                self.session_active, self.stats.get("week_quota_pct") or 0)
            self.clawd_mini.set_from_pixbuf(self.frames_mini.get(**kw))
            self.clawd_mini.get_parent().move(self.clawd_mini, 0, y)
            return True


    if not ICON_PATH.exists():
        write_icon()
    win = Widget()
    try:
        win.set_icon_from_file(str(ICON_PATH))
    except Exception:
        pass
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.stack.set_visible_child_name(win.mode)
    Gtk.main()


# ----------------------------------------------------------- Tkinter widget
# The Windows build. Tk ships with Python, so the widget stays a single file
# with nothing to install — the same promise the GTK build makes on Linux.

TK_BG = "#1a1a18"
TK_CARD = "#262624"
TK_TILE = "#30302e"
TK_FG = "#f5f4ef"
TK_MUTED = "#9c9a94"
TK_CORAL = "#D97757"
TK_TRACK = "#3c3c3a"
TK_HEAT = ["#3c3c3a", "#4a5a8c", "#4568b8", "#3d6bf2", "#4f78ff"]
# a record marker is not a limit, so never dress it up as danger
TK_NEUTRAL = "#5b7bb8"

# Tk 8.6 on Windows lays Hebrew out itself — verified against 8.6.13, which
# reorders and right-aligns correctly. An earlier version of this backend
# reversed the strings by hand on the assumption that it would not, and that
# turned perfectly good Hebrew into gibberish. Pass the text through as-is;
# only the alignment and the widget order are ours to mirror.

def declare_dpi_aware():
    """Tell Windows we will do our own scaling.

    Without this, a widget on a 125% or 150% display is rendered at 96 DPI and
    then bitmap-stretched by the compositor: every label goes soft and the
    pixel art turns to mush. Ask for per-monitor awareness, fall back to
    system awareness on Windows 8 and older.
    """
    import ctypes
    try:
        ctypes.windll.shcore.SetProcessDpiAwareness(2)   # per-monitor
    except (AttributeError, OSError):
        try:
            ctypes.windll.user32.SetProcessDPIAware()
        except (AttributeError, OSError):
            pass


def run_gui_tk():
    import tkinter as tk

    declare_dpi_aware()
    if not ICON_PATH.exists():
        write_icon()
    root = tk.Tk()
    root.withdraw()          # stay hidden until we know where to put it
    root.title("Claude Stats")

    # Everything below is authored at 96 DPI and scaled up from there, so the
    # layout is identical on a laptop at 150% and an external screen at 100%.
    SCALE = root.winfo_fpixels("1i") / 96.0

    def px(n):
        return max(1, int(round(n * SCALE)))

    HEAT_GAP, HEAT_CELL = px(2), px(18)
    CONTENT_W = HEATMAP_WEEKS * HEAT_CELL + (HEATMAP_WEEKS - 1) * HEAT_GAP
    TILE_GAP = px(8)
    TILE_W = (CONTENT_W - 3 * TILE_GAP) // 4
    TILE_H = px(54)
    # the pixel art scales in whole pixels or not at all
    BIG_CELL, MINI_CELL = max(1, round(5 * SCALE)), max(1, round(2 * SCALE))
    STRIP_H = px(72)
    MINI_W = px(170)
    PAD = px(14)
    MINI_PAD = px(10)
    FONT = "Segoe UI"

    class FrameCache:
        """Clawd's frames, drawn once and kept."""

        def __init__(self, cell, bg):
            self.cell = cell
            self.bg = bg
            self.cache = {}

        def get(self, feet="idle", eyes="open", arms=None, zzz=0, flag=0,
                laptop=0, confetti=-1, flip=False):
            key = (feet, eyes, arms, zzz, flag, laptop, confetti, flip)
            img = self.cache.get(key)
            if img is None:
                grid = clawd_grid(feet, eyes, arms, zzz, flag, laptop, confetti)
                rows = []
                for row in grid:
                    chars = row[::-1] if flip else row
                    rows.append("{" + " ".join(
                        CLAWD_COLORS.get(ch, self.bg) for ch in chars) + "}")
                base = tk.PhotoImage(width=CANVAS_W, height=CANVAS_H)
                base.put(" ".join(rows))
                # put() one cell at a time would be ~7k Tcl values per frame;
                # zoom scales the 22x13 original in C instead
                img = base.zoom(self.cell)
                self.cache[key] = img
            return img

    class Tooltip:
        """Tk has no tooltips, and these carry the honest caveats."""

        def __init__(self, widget):
            self.widget = widget
            self.text = ""
            self.justify = "left"
            self.win = None
            self.after_id = None
            widget.bind("<Enter>", self._schedule, add="+")
            widget.bind("<Leave>", self._hide, add="+")
            widget.bind("<Button-1>", self._hide, add="+")

        def set(self, text, justify="left"):
            self.text = text
            self.justify = justify

        def _schedule(self, _e=None):
            self._cancel()
            self.after_id = self.widget.after(450, self._show)

        def _cancel(self):
            if self.after_id is not None:
                self.widget.after_cancel(self.after_id)
                self.after_id = None

        def _show(self):
            if self.win or not self.text:
                return
            self.win = tk.Toplevel(self.widget)
            self.win.overrideredirect(True)
            self.win.attributes("-topmost", True)
            tk.Label(self.win, text=self.text, bg=TK_TILE, fg=TK_FG,
                     font=(FONT, 8), justify=self.justify, padx=px(8), pady=px(5),
                     bd=0).pack()
            self.win.geometry("+%d+%d" % (self.widget.winfo_rootx() + px(12),
                                          self.widget.winfo_rooty() + px(22)))

        def _hide(self, _e=None):
            self._cancel()
            if self.win:
                self.win.destroy()
                self.win = None

    class Meter:
        """A pill-shaped level bar, drawn on a canvas."""

        H = px(9)

        def __init__(self, parent, width, bg):
            self.width = width
            self.bg = bg
            self.canvas = tk.Canvas(parent, width=width, height=self.H, bg=bg,
                                    highlightthickness=0, bd=0)
            self.tip = Tooltip(self.canvas)
            self.set(0.0, TK_NEUTRAL)

        def _pill(self, x0, x1, color):
            h = self.H
            if x1 - x0 <= 0:
                return
            self.canvas.create_oval(x0, 0, x0 + h, h, fill=color, outline="")
            if x1 - x0 > h:
                self.canvas.create_oval(x1 - h, 0, x1, h, fill=color,
                                        outline="")
                self.canvas.create_rectangle(x0 + h / 2, 0, x1 - h / 2, h,
                                             fill=color, outline="")

        def set(self, pct, color):
            self.canvas.delete("all")
            self._pill(0, self.width, TK_TRACK)
            self._pill(0, max(0.0, min(100.0, pct)) / 100.0 * self.width, color)

    class Widget:
        def __init__(self, root):
            self.root = root
            self.stats = {}
            self.config = load_config()
            self.lang = self.config.get("lang", default_lang())
            self.mode = self.config.get("mode", "expanded")
            self.frames_big = FrameCache(BIG_CELL, TK_CARD)
            self.frames_mini = FrameCache(MINI_CELL, TK_CARD)
            self.clawd = ClawdEngine()
            self.clawd_mini_engine = MiniClawdEngine()
            self.polling = False
            self.poll_result = None
            self.session_active = False
            self.script_mtime = script_mtime()
            self.last_seen_mtime = newest_transcript_mtime()
            self.alerted = {}
            self.drag_from = None

            root.configure(bg=TK_BG)
            root.overrideredirect(True)
            root.attributes("-topmost", True)
            root.bind("<Escape>", lambda _e: self.quit())
            root.protocol("WM_DELETE_WINDOW", self.quit)

            self.pages = {}
            self.build()
            self.set_mode(self.mode, first=True)
            self.refresh()
            # A window has no true size until it is mapped, and a withdrawn
            # one reports 1x1 - which put the widget's left edge where its
            # right edge belonged. Map it out of sight, measure, then move it
            # to where it goes; nothing is ever drawn at the wrong place.
            root.geometry("+-4000+-4000")
            root.deiconify()
            root.update()
            self.restore_position()

            root.after(REFRESH_SECONDS * 1000, self.tick_refresh)
            root.after(120, self.animate_big)
            root.after(350, self.animate_mini)
            root.after(WATCH_SECONDS * 1000, self.watch)
            root.after(1000, self.tick_countdown)
            root.after(USAGE_POLL_SECONDS * 1000, self.tick_usage_poll)
            self.spawn_usage_poll()

        # ---------------------------------------------------------- chrome
        def tr(self, key, **kw):
            text = TR[self.lang][key]
            return text.format(**kw) if kw else text

        def button(self, parent, text, command):
            lab = tk.Label(parent, text=text, bg=parent["bg"], fg=TK_MUTED,
                           font=(FONT, 10), cursor="hand2", padx=px(5))
            lab.bind("<Button-1>", lambda _e: command())
            lab.bind("<Enter>", lambda _e: lab.configure(fg=TK_FG))
            lab.bind("<Leave>", lambda _e: lab.configure(fg=TK_MUTED))
            self.buttons.add(lab)
            return lab

        def arm_drag(self, widget):
            """Anything that is not a control drags the window."""
            if widget not in self.buttons:
                widget.bind("<Button-1>", self.on_drag_start, add="+")
                widget.bind("<B1-Motion>", self.on_drag_move, add="+")
                widget.bind("<ButtonRelease-1>", self.on_drag_end, add="+")
            for child in widget.winfo_children():
                self.arm_drag(child)

        def on_drag_start(self, event):
            self.drag_from = (event.x_root - self.root.winfo_x(),
                              event.y_root - self.root.winfo_y())

        def on_drag_move(self, event):
            if not self.drag_from:
                return
            self.root.geometry("+%d+%d" % (event.x_root - self.drag_from[0],
                                           event.y_root - self.drag_from[1]))

        def on_drag_end(self, _event):
            if not self.drag_from:
                return
            self.drag_from = None
            # an override-redirect window gets no help from the shell in
            # remembering where it was, so remember it here
            self.config = update_config(
                pos=[self.root.winfo_x(), self.root.winfo_y()])

        def restore_position(self):
            w = max(self.root.winfo_width(), self.root.winfo_reqwidth())
            h = max(self.root.winfo_height(), self.root.winfo_reqheight())
            sw = self.root.winfo_screenwidth()
            sh = self.root.winfo_screenheight()
            pos = self.config.get("pos")
            if not (isinstance(pos, list) and len(pos) == 2):
                pos = [sw - w - px(40), px(60)]
            # a monitor that has since been unplugged, or a resolution change,
            # must not strand the widget off-screen
            x = max(0, min(int(pos[0]), sw - w))
            y = max(0, min(int(pos[1]), sh - h))
            self.root.geometry("+%d+%d" % (x, y))

        def quit(self):
            self.root.destroy()

        # ----------------------------------------------------------- pages
        def build(self):
            for page in self.pages.values():
                page.destroy()
            self.pages = {}
            self.buttons = set()
            self.rtl = self.lang == "he"
            self.anchor = "e" if self.rtl else "w"
            self.build_full()
            self.build_mini()
            for page in self.pages.values():
                self.arm_drag(page)

        def _side(self, primary):
            """Headers read from the language's own starting edge."""
            if primary:
                return "right" if self.rtl else "left"
            return "left" if self.rtl else "right"

        def build_full(self):
            card = tk.Frame(self.root, bg=TK_CARD, padx=PAD, pady=PAD)
            self.pages["expanded"] = card

            header = tk.Frame(card, bg=TK_CARD)
            header.pack(fill="x")
            self.title_label = tk.Label(header, text=self.tr("title"),
                                        bg=TK_CARD, fg=TK_FG,
                                        font=(FONT, 10, "bold"))
            self.title_label.pack(side=self._side(True))
            for text, cmd in (("✕", self.quit),
                              ("\U0001F5D5", lambda: self.set_mode("mini")),
                              ("⟳", self.manual_refresh),
                              (self.tr("toggle"), self.toggle_lang)):
                self.button(header, text, cmd).pack(side=self._side(False))

            grid = tk.Frame(card, bg=TK_CARD)
            grid.pack(fill="x", pady=(px(10), 0))
            self.tiles = {}
            for i, key in enumerate(STAT_KEYS):
                col = i % 4
                # the tiles are a reading order, so mirror them in Hebrew
                col = 3 - col if self.rtl else col
                tile = tk.Frame(grid, bg=TK_TILE, padx=px(10), pady=px(7),
                                width=TILE_W, height=TILE_H)
                tile.grid(row=i // 4, column=col, padx=(0, TILE_GAP),
                          pady=(0, TILE_GAP), sticky="nsew")
                tile.grid_propagate(False)
                tk.Label(tile, text=self.tr(key), bg=TK_TILE, fg=TK_MUTED,
                         font=(FONT, 8), anchor=self.anchor).pack(fill="x")
                val = tk.Label(tile, text="…", bg=TK_TILE, fg=TK_FG,
                               font=(FONT, 14, "bold"), anchor=self.anchor)
                val.pack(fill="x")
                self.tiles[key] = val
            for c in range(4):
                grid.grid_columnconfigure(c, weight=1, minsize=TILE_W)
            for r in range(2):
                grid.grid_rowconfigure(r, minsize=TILE_H)

            meters = tk.Frame(card, bg=TK_CARD)
            meters.pack(fill="x", pady=(px(4), 0))
            self.full_meters = {}
            half = (CONTENT_W - 12) // 2
            for i, key in enumerate(("hour5", "week")):
                col = (1 - i) if self.rtl else i
                box = tk.Frame(meters, bg=TK_CARD, width=half)
                box.grid(row=0, column=col, padx=(0, px(12)), sticky="ew")
                row = tk.Frame(box, bg=TK_CARD)
                row.pack(fill="x")
                lab = tk.Label(row, bg=TK_CARD, fg=TK_MUTED, font=(FONT, 8))
                lab.pack(side=self._side(True))
                pct = tk.Label(row, bg=TK_CARD, fg=TK_FG,
                               font=(FONT, 9, "bold"))
                pct.pack(side=self._side(False))
                bar = Meter(box, half, TK_CARD)
                bar.canvas.pack(fill="x", pady=(px(2), 0))
                self.full_meters[key] = (lab, pct, bar)
            for c in range(2):
                meters.grid_columnconfigure(c, weight=1, minsize=half)

            # the heatmap stays chronological left→right in both languages
            self.heatmap = tk.Canvas(card, width=CONTENT_W,
                                     height=7 * HEAT_CELL + 6 * HEAT_GAP,
                                     bg=TK_CARD, highlightthickness=0, bd=0)
            self.heatmap.pack(pady=(px(12), 0))
            self.heat_cells = {}
            for col in range(HEATMAP_WEEKS):
                for row in range(7):
                    x = col * (HEAT_CELL + HEAT_GAP)
                    y = row * (HEAT_CELL + HEAT_GAP)
                    self.heat_cells[(col, row)] = self.heatmap.create_rectangle(
                        x, y, x + HEAT_CELL, y + HEAT_CELL,
                        fill=TK_HEAT[0], outline="")

            self.strip = tk.Canvas(card, width=CONTENT_W, height=STRIP_H,
                                   bg=TK_CARD, highlightthickness=0, bd=0)
            self.strip.pack(pady=(px(10), 0))
            self.clawd_big = self.strip.create_image(
                10, 2, anchor="nw", image=self.frames_big.get())

            self.footer = tk.Label(card, text="", bg=TK_CARD, fg=TK_MUTED,
                                   font=(FONT, 8), anchor=self.anchor,
                                   justify="right" if self.rtl else "left",
                                   wraplength=CONTENT_W)
            self.footer.pack(fill="x", pady=(px(8), 0))

        def build_mini(self):
            card = tk.Frame(self.root, bg=TK_CARD, padx=MINI_PAD, pady=MINI_PAD)
            self.pages["mini"] = card

            top = tk.Frame(card, bg=TK_CARD)
            top.pack(fill="x")
            self.corner = tk.Canvas(top, width=CANVAS_W * MINI_CELL,
                                    height=CANVAS_H * MINI_CELL + 4,
                                    bg=TK_CARD, highlightthickness=0, bd=0)
            self.corner.pack(side=self._side(True))
            self.clawd_mini = self.corner.create_image(
                0, 4, anchor="nw", image=self.frames_mini.get())
            tk.Label(top, text="Claude", bg=TK_CARD, fg=TK_CORAL,
                     font=(FONT, 11, "bold")).pack(side=self._side(True),
                                                   padx=(px(6), 0))
            for text, cmd in (("⤢", lambda: self.set_mode("expanded")),
                              ("⟳", self.manual_refresh)):
                self.button(top, text, cmd).pack(side=self._side(False))

            self.mini_meters = {}
            for key in ("hour5", "week"):
                row = tk.Frame(card, bg=TK_CARD)
                row.pack(fill="x", pady=(px(6), 0))
                lab = tk.Label(row, bg=TK_CARD, fg=TK_MUTED, font=(FONT, 8))
                lab.pack(side=self._side(True))
                pct = tk.Label(row, bg=TK_CARD, fg=TK_FG,
                               font=(FONT, 9, "bold"))
                pct.pack(side=self._side(False))
                bar = Meter(card, MINI_W, TK_CARD)
                bar.canvas.pack(fill="x", pady=(px(2), 0))
                self.mini_meters[key] = (lab, pct, bar)

        # -------------------------------------------------------- behavior
        def set_mode(self, mode, first=False):
            self.mode = mode
            for name, page in self.pages.items():
                if name == mode:
                    page.pack()
                else:
                    page.pack_forget()
            if not first:
                self.config = update_config(mode=mode)
            # Let the window shrink back to whichever page is showing. An
            # empty geometry drops the position along with the size, so put
            # the widget back where the user left it.
            x, y = self.root.winfo_x(), self.root.winfo_y()
            self.root.geometry("")
            self.root.update_idletasks()
            if not first:
                self.root.geometry("+%d+%d" % (x, y))

        def toggle_lang(self):
            self.lang = "en" if self.lang == "he" else "he"
            self.config = update_config(lang=self.lang)
            x, y = self.root.winfo_x(), self.root.winfo_y()
            # a rebuild is cheaper to get right than re-mirroring every
            # packed widget in place, and it is instant at this size
            self.build()
            self.set_mode(self.mode, first=True)
            self.refresh()
            self.root.update_idletasks()
            self.root.geometry("+%d+%d" % (x, y))

        def manual_refresh(self):
            self.refresh()

        # ------------------------------------------------------------ data
        def tick_refresh(self):
            self.refresh()
            self.root.after(REFRESH_SECONDS * 1000, self.tick_refresh)

        def watch(self):
            """Cheap tick: notice live sessions, fresh data and new code."""
            newest = newest_transcript_mtime()
            was_active = self.session_active
            self.session_active = (time.time() - newest) < ACTIVE_WINDOW
            if self.session_active and newest > self.last_seen_mtime:
                self.last_seen_mtime = newest
                self.refresh()
            elif was_active and not self.session_active:
                self.refresh()
            mtime = script_mtime()
            if mtime and self.script_mtime and mtime != self.script_mtime:
                restart_process()
            self.root.after(WATCH_SECONDS * 1000, self.watch)

        def refresh(self):
            try:
                self.stats = collect_stats()
            except Exception as exc:  # keep the widget alive on parse errors
                self.footer.configure(text=self.tr("err", e=exc))
                return
            s = self.stats
            for key, text in (
                    ("sessions", str(s["sessions"])),
                    ("messages", str(s["messages"])),
                    ("total_tokens", fmt_num(s["total_tokens"])),
                    ("active_days", str(s["active_days"])),
                    ("current_streak", f'{s["current_streak"]}d'),
                    ("longest_streak", f'{s["longest_streak"]}d'),
                    ("peak_hour", fmt_hour(s["peak_hour"])),
                    ("favorite_model", s["favorite_model"])):
                self.tiles[key].configure(text=text)
            self.footer.configure(text=hp_line(s["total_tokens"], self.lang))
            self.tick_meters()
            for title, body, critical in alert_messages(s, self.alerted,
                                                        self.lang):
                notify(title, body, critical)
            self.update_heatmap()

        def spawn_usage_poll(self):
            """Refresh the real quota off-thread so the UI never stalls."""
            if self.polling:
                return
            self.polling = True

            def work():
                # Tk is single-threaded: hand the answer back through an
                # attribute and let the countdown tick pick it up, rather than
                # touching widgets from here
                try:
                    self.poll_result = poll_usage()
                finally:
                    self.polling = False

            threading.Thread(target=work, daemon=True).start()

        def tick_usage_poll(self):
            self.spawn_usage_poll()
            self.root.after(USAGE_POLL_SECONDS * 1000, self.tick_usage_poll)

        def tick_countdown(self):
            if self.poll_result is not None:
                self.poll_result = None
                self.refresh()
            else:
                self.tick_meters()
            self.root.after(1000, self.tick_countdown)

        def tick_meters(self):
            """Second-by-second countdown to each window's reset."""
            if not self.stats:
                return
            now = time.time()
            for key, win_key in (("hour5", "window_5h"), ("week", "window_7d")):
                win = self.stats.get(win_key) or {}
                resets = win.get("resets_at")
                span = win.get("window_seconds") or 1
                if resets:
                    left = max(0, int(resets - now))
                    elapsed = 100.0 * (1 - left / span)
                    countdown = fmt_countdown(left, self.lang)
                else:
                    # no open window: the session is over, quota is fresh
                    elapsed, countdown = 100.0, self.tr("fresh")
                quota = win.get("quota_pct")
                real_quota = quota is not None
                if real_quota:
                    # the honest meter: how much of the quota is gone,
                    # straight from the server's own answer to /usage
                    elapsed = float(quota)
                    text = f"{quota:.0f}%"
                    tip = TR[self.lang]["tip_quota"].format(
                        age=win.get("quota_age_min") or 0,
                        reset=win.get("quota_reset") or "?")
                    color = ("#e0645c" if elapsed >= 80 else
                             "#e8a34c" if elapsed >= 50 else "#6fbf73")
                elif key == "hour5":
                    text = f"{elapsed:.0f}%"
                    tip = TR[self.lang]["tip_session"].format(left=countdown)
                    # time progress stays neutral: a session ending is not a
                    # danger, and colouring it red would say it was
                    color = TK_NEUTRAL
                else:
                    text = countdown
                    tip = TR[self.lang]["tip_countdown"]
                    color = TK_NEUTRAL
                for meters in (self.full_meters, self.mini_meters):
                    lab, val, bar = meters[key]
                    lab.configure(text=self.tr(
                        f"{key}_short" if meters is self.mini_meters
                        else (f"{key}_quota" if real_quota
                              else f"{key}_reset")))
                    val.configure(text=text)
                    bar.set(elapsed, color)
                    bar.tip.set(tip, "right" if self.rtl else "left")

        def update_heatmap(self):
            activity = {date.fromisoformat(k): v
                        for k, v in self.stats.get("day_activity", {}).items()}
            peak = max(activity.values(), default=1) or 1
            today = date.today()
            end_week_start = week_start(today)
            for col in range(HEATMAP_WEEKS):
                ws = end_week_start - timedelta(weeks=HEATMAP_WEEKS - 1 - col)
                for row in range(7):
                    d = ws + timedelta(days=row)
                    count = activity.get(d, 0) if d <= today else 0
                    level = 0 if count <= 0 else 1 + min(3, int(3 * count / peak))
                    self.heatmap.itemconfigure(self.heat_cells[(col, row)],
                                               fill=TK_HEAT[level])

        # ------------------------------------------------------- animation
        def animate_big(self):
            if self.mode == "expanded":
                kw, x, y = self.clawd.step(
                    CONTENT_W, BIG_CELL, self.session_active,
                    self.stats.get("week_quota_pct") or 0)
                self.strip.itemconfigure(self.clawd_big,
                                         image=self.frames_big.get(**kw))
                self.strip.coords(self.clawd_big, x, y)
            self.root.after(120, self.animate_big)

        def animate_mini(self):
            if self.mode == "mini":
                kw, y = self.clawd_mini_engine.step(
                    self.session_active, self.stats.get("week_quota_pct") or 0)
                self.corner.itemconfigure(self.clawd_mini,
                                          image=self.frames_mini.get(**kw))
                self.corner.coords(self.clawd_mini, 0, y)
            self.root.after(350, self.animate_mini)

    try:
        root.iconphoto(True, tk.PhotoImage(file=str(ICON_PATH)))
    except tk.TclError:
        pass                # a missing icon must never stop the widget
    Widget(root)
    root.focus_force()
    root.mainloop()


def run_gui():
    """Pick the toolkit that actually exists on this desktop."""
    if IS_WINDOWS:
        return run_gui_tk()
    return run_gui_gtk()


if __name__ == "__main__":
    if "--write-icon" in sys.argv:
        sys.exit(0 if write_icon() else 1)
    if "--json" in sys.argv:
        print(json.dumps(collect_stats(), ensure_ascii=False, indent=2))
    else:
        run_gui()
